{
  "expo": {
    "name": "buddy-up",
    "slug": "buddy-up",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/buddyup-logo-32.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "buddyup",
    "splash": {
      "image": "./assets/buddyup-logo-32.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.buddyup",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/buddyup-logo-32.png",
        "backgroundColor": "#ffffff"
      },
      "googleServicesFile": "./google-services.json",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.buddyup",
      "notification": {
        "icon": "./assets/buddyup-logo-64.png",
        "color": "#ffffff",
        "sound": "default"
      }
    },
    "web": {
      "favicon": "./assets/buddyup-logo-32.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/buddyup-logo-32.png",
          "color": "#ffffff",
          "mode": "production"
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "b12a8f95-6629-4fb5-9a6b-86d51fdf96ad"
      }
    },
    "owner": "vvuminhhieu"
  }
}
